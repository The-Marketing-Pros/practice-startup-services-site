---
import BaseLayout from '@layouts/BaseLayout.astro';
import ConsultationBooking from '@components/ConsultationBooking.astro';
---
<BaseLayout title="Book a Free Practice Startup Consultation" description="Schedule a free consultation about your medical practice startup, launch timeline, and credentialing questions.">
  <section class="container-site py-12 lg:py-20">
    <div class="max-w-3xl mx-auto">
      <div class="phase-label text-bronze-700 mb-5">Free practice startup support</div>
      <h1 class="font-display text-display-lg font-medium text-ink mb-5">Make a plan for your practice.</h1>
      <p class="text-lede text-graphite-700">Bring your questions about getting started. Choose a time below and meet with a practice startup specialist.</p>
      <ConsultationBooking />
    </div>
  </section>
</BaseLayout>
