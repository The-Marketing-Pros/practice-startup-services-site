---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@styles/resources.css';
const subject=encodeURIComponent('Free LaborGenie HIPAA training license — Practice Startup Services');
const body=encodeURIComponent('Hello PPS,\n\nI would like to request the free LaborGenie HIPAA training license offered on PracticeStartupServices.com.\n\nMy name:\nPractice name:\nState:\nPreferred email for access:\n\nPlease send the license details and next steps. Thank you.');
---
<BaseLayout title="Free LaborGenie HIPAA Training License" description="Request a free LaborGenie license through PPS for HIPAA training and a certificate of completion. Prepare for your practice launch.">
<div class="resource-site"><div class="rs-wrap">
 <section class="rs-hero"><div class="rs-breadcrumb"><a href="/resources/">Free resources</a><span>/</span><span>HIPAA training</span></div><span class="rs-tag">Free license offer from PPS</span><h1 class="rs-title" style="margin-top:20px">Build training into your launch.</h1><p class="rs-intro">Request a free LaborGenie license for HIPAA training, with a certificate of completion after you finish the required coursework.</p></section>
 <section class="rs-tools"><div class="rs-panel"><p class="rs-kicker">Your next step</p><h2>Request your free license.</h2><p>PPS will coordinate your access and confirm the license details. Send your name, practice name, state, and the email you want to use for training.</p><div class="rs-actions"><a class="rs-btn" href={`mailto:sales@physicianpracticespecialists.com?subject=${subject}&body=${body}`}>Email PPS for my free license</a></div><p class="rs-small">Opens your email app with a prepared request. Access is arranged by the PPS team; it is not activated automatically.</p><p class="rs-small" style="margin-top:16px">No email app? Use the <a class="rs-link" href="https://physicianpracticespecialists.com/contact/">PPS contact page</a> and mention “free LaborGenie HIPAA training license.”</p></div>
 <div class="rs-panel" style="background:#eaf0e5"><p class="rs-kicker">Training with a record</p><h2>Learn, complete, keep your record.</h2><ol style="list-style:decimal;padding-left:22px;display:grid;gap:16px"><li><strong>Request access.</strong> The PPS team sends your next steps.</li><li><strong>Complete your training.</strong> Work through the applicable LaborGenie HIPAA coursework.</li><li><strong>Keep your completion record.</strong> Add the certificate to your training documentation.</li></ol></div></section>
 <section class="rs-section" style="max-width:780px"><h2>One part of getting your practice ready.</h2><p>HIPAA training supports a broader privacy and security program. A training certificate documents course completion; it is not government certification and does not, by itself, establish that a practice meets HIPAA requirements.</p><p style="margin-top:15px">Your practice also needs policies, role-specific procedures, safeguards, and other measures appropriate to its obligations. <a class="rs-link" href="https://www.hhs.gov/hipaa/for-professionals/security/laws-regulations/index.html">Read HHS guidance on the HIPAA Security Rule</a>.</p><div class="rs-actions"><a href="/resources/startup-checklist/" class="rs-btn secondary">Build my startup checklist</a><a href="/resources/pro-forma/" class="rs-btn secondary">Build my pro forma</a></div></section>
</div></div>
</BaseLayout>
