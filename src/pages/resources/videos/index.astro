---
import BaseLayout from '@layouts/BaseLayout.astro';
import LearningNav from '@components/LearningNav.astro';
import LearningSupport from '@components/LearningSupport.astro';
import { publishedVideos, plannedVideoTopics } from '@data/videos';
import '@styles/learning.css';
---
<BaseLayout title="Practice Startup Video Library" description="A home for future PPS practice startup walkthroughs. Explore planned topics and read the available companion articles today.">
<div class="learning"><section class="learn-hero"><div class="learn-wrap"><div class="learn-eyebrow">The video library</div><h1 class="learn-title">See the next step.<br/><em>Then make it yours.</em></h1><p class="learn-intro">A home for practical walkthroughs from PPS, covering the tools and decisions involved in opening your practice.</p></div></section><LearningNav /><section class="learn-section"><div class="learn-wrap">{publishedVideos.length>0 ? <><div class="learn-heading"><h2>Watch and learn.</h2></div><div class="learn-grid">{publishedVideos.map(video=><article class="learn-card"><span class="learn-tag">{video.durationLabel}</span><h3>{video.title}</h3><p>{video.description}</p><a class="learn-btn" href={video.watchUrl}>Watch video</a><a class="learn-link" href={video.transcriptUrl}>Read transcript</a></article>)}</div></> : <div class="learn-video-feature"><div class="learn-video-symbol" aria-hidden="true"><svg width="42" height="42" viewBox="0 0 42 42" fill="none"><rect x="3" y="8" width="25" height="26" rx="5" stroke="currentColor" stroke-width="2"/><path d="m28 17 10-6v20l-10-6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div><div><div class="learn-eyebrow" style="color:#c2efd9">Coming soon</div><h2>The library is ready. Recordings are next.</h2><p>No videos are published yet. While we prepare the walkthroughs, you can use the free planning tools and read the companion articles below.</p></div></div>}<div class="learn-heading" style="margin-top:40px"><div><div class="learn-eyebrow">On the recording list</div><h2>Topics we’re planning.</h2><p>These are planned walkthroughs, with articles you can read today.</p></div></div><div class="learn-grid">{plannedVideoTopics.map(topic=><article class="learn-card"><span class="learn-tag">Planned video</span><h3>{topic.title}</h3><p>{topic.description}</p><a class="learn-link" href={`/resources/articles/${topic.articleSlug}/`}>Read the companion article</a></article>)}</div></div></section><LearningSupport /></div>
</BaseLayout>
