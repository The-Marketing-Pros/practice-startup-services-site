---
import BaseLayout from '@layouts/BaseLayout.astro';
import PlannerStorage from '@components/PlannerStorage.astro';
import StartupRegistration from '@components/StartupRegistration.astro';
import {financeFields, payerKeys, payerLabels} from '../../lib/planners/finance';
import {presetPayerMixes} from '../../lib/planners/presets';
import {specialties, practiceModels, launchStages} from '../../lib/startup/options';
import '@styles/resources.css';
const groups=[['volume','Patient volume & collections'],['startup','Startup costs & funding'],['monthly','Monthly expenses']];
---
<BaseLayout title="Free Medical Practice Pro Forma Builder" description="Build a customized 24-month startup cash forecast. Model revenue, expenses, collection delays, and funding needs, then download Excel or PDF.">
<div class="resource-site"><div class="rs-wrap">
 <section class="rs-hero compact"><div class="rs-breadcrumb"><a href="/resources/">Free resources</a><span>/</span><span>Pro forma builder</span></div><p class="rs-kicker">Know what your launch needs</p><h1 class="rs-title">Put numbers behind your plan.</h1><p class="rs-intro">Build a 24-month cash forecast for your practice. Start from your specialty, practice model, payer mix and launch stage, then replace every starting assumption with your own quotes and download an editable pro forma.</p><a class="rs-link rs-mobile-jump" href="#cash-forecast">Go to my forecast & downloads</a></section>
 <noscript><p class="rs-notice">Enable JavaScript to use the pro forma builder, or read the <a class="rs-link" href="/resources/startup-costs/">startup cost guide</a>.</p></noscript>
 <div class="rs-workspace rs-finance rs-has-js" id="finance-app">
  <aside class="rs-panel"><h2>Your assumptions</h2><p class="rs-small">Start with the example, then make it yours. All sample values are illustrative, not industry benchmarks. Amounts are in USD.</p>
   <form id="finance-preset" class="pf-preset" autocomplete="off" aria-labelledby="preset-title">
    <h3 id="preset-title">Start from your practice</h3>
    <p class="rs-small">Fills the inputs below with illustrative starting assumptions for your situation. They are not benchmarks or local data; replace each one with your own quotes.</p>
    <div class="rs-field"><label for="preset-specialty">Specialty</label><select id="preset-specialty" name="specialty" required><option value="">Select your specialty</option>{specialties.map(s=><option value={s.id}>{s.label}</option>)}</select></div>
    <div class="rs-field"><label for="preset-model">Practice model</label><select id="preset-model" name="model" required>{practiceModels.map(o=><option value={o.value}>{o.label}</option>)}</select></div>
    <div class="rs-field"><label for="preset-setting">Care setting</label><select id="preset-setting" name="setting"><option value="office">In-person office</option><option value="telehealth">Telehealth only</option><option value="hybrid">In-person + telehealth</option></select></div>
    <div class="rs-field"><label for="preset-mix">Payer mix</label><select id="preset-mix" name="payerMix">{presetPayerMixes.map(o=><option value={o.value}>{o.label}</option>)}</select></div>
    <div class="rs-field"><label for="preset-stage">Launch stage</label><select id="preset-stage" name="stage">{launchStages.map(o=><option value={o.value} selected={o.value==='planning'}>{o.label}</option>)}</select><small>Sets how many months of overhead you may pay before opening.</small></div>
    <div class="rs-field"><label for="preset-zip">Practice ZIP code (optional)</label><input id="preset-zip" name="zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" /><small>Labels your plan with its state. It never sets a cost.</small></div>
    <button class="rs-btn secondary" type="submit">Apply starting assumptions</button>
    <div id="preset-notes" class="pf-preset-notes" aria-live="polite" hidden></div>
   </form>
   <form id="finance-inputs" autocomplete="off"><div class="rs-form-section rs-fields"><div class="rs-field"><label for="finance-name">Practice name</label><input id="finance-name" name="name" maxlength="100" placeholder="My new practice" /></div><div class="rs-field"><label for="finance-opening">Opening month</label><input type="month" id="finance-opening" name="opening" min="2000-01" max="2099-12" required /></div></div>
   {groups.map(([id,title],i)=><details class="rs-form-section" open={i===0}><summary>{i+1}. {title}</summary><div>{financeFields.filter(f=>f[6]===id).map(([key,label,example,min,max])=><div class="rs-field"><label for={`finance-${key}`}>{label}</label><input type="number" id={`finance-${key}`} name={key} value={example} min={min} max={max} step={['providers','days','ramp','lag'].includes(key)?1:'any'} inputmode="decimal" required />{key==='netPerVisit'&&<small>Expected collectible revenue after contractual adjustments and expected losses, not gross charges.</small>}{key==='providerPay'&&<small>Total monthly compensation for all providers, including you. Payroll burden is added below.</small>}{key==='funding'&&<small>Cash available before opening, including committed loans and owner investment.</small>}{key==='ramp'&&<small>Linear growth from opening utilization. A one-month ramp starts at full capacity.</small>}{key==='debt'&&<small>Principal + interest paid each month. Count loan proceeds in available funding.</small>}{key==='preopening'&&<small>Payroll and one-time costs before opening. Recurring rent, software, insurance, marketing and other fixed costs belong in the months-of-overhead input below, so they are not counted twice.</small>}{key==='preMonths'&&<small>Rent, software, insurance, marketing and other fixed costs you pay before seeing patients. Added to startup costs.</small>}<small class="pf-badge" id={`badge-${key}`} hidden>Starting assumption: replace with your quote</small></div>)}</div></details>)}
   <details class="rs-form-section" id="mix-section" open><summary>4. Payer mix</summary><div>
    <label class="pf-toggle"><input type="checkbox" id="mix-enabled" /> Calculate net collections per visit from my payer mix</label>
    <p class="rs-small">When on, this replaces the single "Expected net collections per visit" input above.</p>
    <div class="pf-mix">{payerKeys.map(k=><fieldset class="pf-mix-row"><legend>{payerLabels[k]}</legend><div class="rs-field"><label for={`mix-${k}-share`}>Share of visits (%)</label><input type="number" id={`mix-${k}-share`} min="0" max="100" step="any" inputmode="decimal" required /></div><div class="rs-field"><label for={`mix-${k}-net`}>Net collections per visit ($)</label><input type="number" id={`mix-${k}-net`} min="0" max="10000" step="any" inputmode="decimal" required /></div><small class="pf-badge" id={`badge-mix-${k}`} hidden>Starting assumption: replace with your contracted rates</small></fieldset>)}</div>
    <p class="pf-formula" id="mix-formula" aria-live="polite"></p>
   </div></details>
   </form><PlannerStorage />
  </aside>
  <section class="rs-panel" id="cash-forecast"><div class="rs-toolbar"><div><h2 style="margin-bottom:5px">Your cash forecast</h2><p class="rs-small">Updates as you change your inputs.</p></div><div class="rs-actions"><button id="finance-xlsx" class="rs-btn">Download Excel</button><button id="finance-pdf" class="rs-btn secondary">Download PDF</button><a class="rs-link" href="#startup-registration">Claim your free LaborGenie license</a></div></div>
   <p id="planner-status" class="rs-status" role="status"></p><div id="finance-errors" role="alert" hidden class="rs-notice warn"></div>
   <div id="finance-results"><p class="rs-notice" id="finance-context" hidden></p><div class="rs-summary"><div class="rs-stat"><span>Startup costs</span><strong id="startup-total"></strong></div><div class="rs-stat"><span>Lowest cash balance</span><strong id="lowest-cash"></strong></div><div class="rs-stat"><span>Additional funding</span><strong id="funding-gap"></strong></div></div>
    <p class="rs-small">Additional funding covers the projected shortfall to stay at $0. Add a reserve for uncertainty.</p>
    <h3>Cash balance over 24 months</h3><svg id="cash-chart" class="rs-chart" viewBox="0 0 620 190" role="img" aria-label="Projected cash balance over 24 months"></svg>
    <p class="rs-small" id="cash-summary" aria-live="polite"></p>
    <div class="rs-notice" id="cash-milestone"></div>
    <div class="rs-summary"><div class="rs-stat"><span>Year 1 cash change</span><strong id="year-one"></strong></div><div class="rs-stat"><span>Year 2 cash change</span><strong id="year-two"></strong></div><div class="rs-stat"><span>Month 24 receivables</span><strong id="receivables"></strong></div></div>
    <p class="rs-small" style="margin-bottom:12px">Cash change is after operating expenses and debt. Receivables are earned revenue still awaiting collection.</p>
    <div class="rs-table-wrap" tabindex="0" role="region" aria-label="24-month cash forecast, scroll horizontally for all columns"><table class="rs-table"><caption class="sr-only">24-month cash forecast in US dollars</caption><thead><tr><th scope="col">Month</th><th scope="col">Visits</th><th scope="col">Earned</th><th scope="col">Collected</th><th scope="col">Operating costs</th><th scope="col">Debt</th><th scope="col">Net cash</th><th scope="col">Cash balance</th></tr></thead><tbody id="finance-months"></tbody></table></div>
   </div>
   <details class="rs-form-section"><summary>How the model works</summary><div class="rs-small"><p>Startup costs are paid before opening. Funding is available upfront. Patient volume ramps linearly to capacity; provider count, working days, and monthly costs remain constant. Collections are delayed by whole months, with no opening receivables. Variable costs are paid as a percentage of cash collections.</p><p style="margin-top:12px"><strong>Payer mix.</strong> When it is on, net collections per visit = (commercial share x commercial net) + (Medicare share x Medicare net) + (Medicaid share x Medicaid net) + (self-pay share x self-pay net), with shares as fractions that add up to 100%. Each payer's net is what you expect to collect per visit after contractual adjustments, not gross charges.</p><p style="margin-top:12px"><strong>Pre-opening overhead.</strong> Months of overhead before opening x (rent + software + insurance + marketing + other fixed costs) is added to startup costs before contingency. Your launch stage sets a starting number of months. To avoid double counting, the separate pre-opening payroll and one-time costs input should not include those recurring fixed costs.</p><p style="margin-top:12px"><strong>Starting assumptions.</strong> Presets fill inputs from your specialty, practice model, care setting, payer mix and launch stage. They are illustrative placeholders, not benchmarks, surveys or local data. A ZIP code only labels the plan.</p><p style="margin-top:12px">This is a cash planning model, not an accrual income statement. It includes provider/owner compensation, payroll burden, and debt payments. It excludes taxes, depreciation, inflation, seasonality, later capital purchases, and later financing. Review your assumptions with your accountant and financing adviser.</p><p style="margin-top:12px">The Excel download includes editable assumptions, formulas, and method notes. Planning framework: <a class="rs-link" href="https://www.sba.gov/counseling/plan-your-business/" target="_blank" rel="noopener">SBA business planning resources</a>.</p></div></details>
   <p class="rs-small" style="margin-top:20px">Keep your launch moving: <a href="/resources/startup-checklist/" class="rs-link">Build your startup checklist</a> or <a href="/resources/startup-research/" class="rs-link">see free research on your ZIP and specialty</a>.</p>
  </section>
 </div>
<StartupRegistration />
</div></div>
<script>import '../../scripts/finance';</script>
</BaseLayout>
