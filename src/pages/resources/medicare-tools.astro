---
import BaseLayout from '@layouts/BaseLayout.astro';
import LearningNav from '@components/LearningNav.astro';
import LearningSupport from '@components/LearningSupport.astro';
import '@styles/learning.css';
const resources = [
  {tag:'Payment research',name:'Physician Fee Schedule',description:'Use the CMS lookup to research Medicare payment information by procedure code and locality. Check the selected year, setting, and tool instructions before using a result in your planning.',href:'https://www.cms.gov/medicare/physician-fee-schedule/search/overview',cta:'Open the CMS fee schedule guide'},
  {tag:'Enrollment maintenance',name:'Revalidation lookup',description:'Search the CMS Medicare Revalidation List for a provider’s due date. Read the current notices and instructions on the CMS tool, and confirm the next step with your Medicare Administrative Contractor when needed.',href:'https://data.cms.gov/tools/medicare-revalidation-list',cta:'Open the CMS revalidation lookup'},
  {tag:'Getting started',name:'Enrollment guidance',description:'Review the CMS enrollment steps and the guidance for your provider or supplier type. Use the official instructions alongside your internal document and application tracker.',href:'https://www.cms.gov/medicare/enrollment-renewal/providers-suppliers',cta:'Read the CMS enrollment guide'},
];
---
<BaseLayout title="Medicare Planning and Enrollment Resources" description="Find official CMS fee schedule, revalidation, and enrollment resources, plus practical support for organizing your practice launch.">
<div class="learning">
<section class="learn-hero"><div class="learn-wrap"><div class="learn-eyebrow">Medicare resources</div><h1 class="learn-title">The right reference.<br/><em>A clearer next step.</em></h1><p class="learn-intro">Keep official Medicare resources close to your planning and enrollment work. Start with the source, record what you find, and bring the questions that need a specialist.</p><div class="learn-actions"><a class="learn-btn" href="#medicare-resources">Explore the resources</a><a class="learn-btn secondary" href="/journey/credentialing-enrollment/">Read the credentialing guide</a></div></div></section>
<LearningNav />
<section class="learn-section" id="medicare-resources"><div class="learn-wrap"><div class="learn-heading"><div><div class="learn-eyebrow">Official CMS sources</div><h2>Three useful places to start.</h2><p>These links open CMS resources. Their current instructions and data apply to each lookup.</p></div></div><div class="learn-grid">{resources.map(r=><article class="learn-card"><span class="learn-tag">{r.tag}</span><h3>{r.name}</h3><p>{r.description}</p><a class="learn-link" href={r.href}>{r.cta}</a></article>)}</div><p class="learn-note">Source links reviewed October 8, 2026. Lookup results are reference information; confirm how they apply to your practice.</p></div></section>
<section class="learn-section"><div class="learn-wrap learn-split"><div><div class="learn-eyebrow">Put the information to work</div><h2>Connect research to your launch plan.</h2><p class="learn-intro">Keep an owner, a next action, and a follow-up date for each application. Record payment assumptions separately in your financial plan so the checklist and budget stay useful as the details change.</p><a class="learn-link" href="/resources/articles/organize-credentialing-before-you-apply/">Read the enrollment organization article</a></div><div class="learn-panel"><h3>Help from the PPS family</h3><p>Explore Medicare application support or the Metolius tool collection when you need another resource for the work ahead.</p><div class="learn-actions"><a class="learn-btn secondary" href="https://medicareapplications.com/">Medicare application support</a><a class="learn-link" href="https://mymetolius.com/tools">Explore Metolius tools</a></div></div></div></section>
<LearningSupport />
</div></BaseLayout>
