---
import BaseLayout from '@layouts/BaseLayout.astro';
import LearningNav from '@components/LearningNav.astro';
import LearningArticles from '@components/LearningArticles.astro';
import LearningSupport from '@components/LearningSupport.astro';
import { publishedArticles } from '@data/articles';
import '@styles/learning.css';
---
<BaseLayout title="Practice Startup Articles & Guides" description="Practical articles on launch planning, startup budgets, and credentialing, with free tools to put each idea to work.">
<div class="learning"><section class="learn-hero"><div class="learn-wrap"><div class="learn-eyebrow">The practice startup reading room</div><h1 class="learn-title">Good questions.<br/><em>Practical answers.</em></h1><p class="learn-intro">Explore one decision at a time. These articles help you organize the work, ask better questions, and take the next step toward opening your practice.</p><div class="learn-actions"><a class="learn-btn" href="#articles">Browse articles</a><a class="learn-btn secondary" href="/journey/">Explore the launch roadmap</a></div></div></section><LearningNav /><section class="learn-section" id="articles"><div class="learn-wrap"><div class="learn-heading"><div><div class="learn-eyebrow">Read at your own pace</div><h2>{publishedArticles.length} articles to get you moving.</h2></div><a class="learn-link" href="/resources/videos/">Video library — coming soon</a></div><LearningArticles /></div></section><LearningSupport /></div>
</BaseLayout>
