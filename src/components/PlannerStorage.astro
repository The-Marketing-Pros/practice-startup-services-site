<div class="rs-storage rs-no-print">
  <p class="rs-small" id="save-status" aria-live="polite">Your plan saves on this browser.</p>
  <p class="rs-small">No account needed. These inputs stay on this device; downloads are created here. Avoid patient or other sensitive information. Clearing browser data removes the saved plan.</p>
  <div class="rs-actions">
    <button type="button" class="rs-text-btn" id="backup-plan">Download backup</button>
    <button type="button" class="rs-text-btn" id="restore-plan">Restore backup</button>
    <button type="button" class="rs-text-btn" id="reset-plan">Start over</button>
  </div>
  <input class="rs-file" id="backup-file" type="file" accept="application/json,.json" aria-label="Choose a planner backup" />
</div>
