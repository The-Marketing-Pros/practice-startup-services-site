---
import PracticeElfHandoff from "./PracticeElfHandoff.astro";
const { starting = false } = Astro.props;
const phases = [
  ["Decide", "Shape your practice and understand your market.", "is-this-right-for-me"],
  ["Plan", "Put numbers, funding, and a timeline behind the idea.", "business-planning"],
  ["Form", "Organize your entity and professional requirements.", "legal-entity-setup"],
  ["Credential", "Track applications, contracts, and effective dates.", "credentialing-enrollment"],
  ["Build", "Prepare your space, systems, team, and workflows.", "infrastructure-technology"],
  ["Launch", "Rehearse the patient journey and review readiness.", "launch-marketing"],
  ["Grow", "Compare the plan with actual results and improve.", "grow-optimize"],
];
---
<div class="launch-home">
  <section class="home-intro">
    <div>
      <p class="eyebrow">Your practice, taking shape</p>
      <h1>{starting ? "A clearer path to opening day." : "My launch plan."}</h1>
      <p class="intro">{starting ? "Start with the questions that matter. Turn your idea into a practical checklist, understand the cash you need, and get help when you want it." : "Pick up where you left off. Your checklist and cash forecast, together in one place."}</p>
      <div class="intro-actions"><a class="button" href="/resources/startup-checklist/">{starting ? "Build my free plan" : "Open my checklist"} <span aria-hidden="true">↗</span></a><a class="light-link" href="/resources/pro-forma/">Explore my financial plan →</a></div>
      <p class="promise">Free tools · No signup required · Plans stay on this browser</p>
    </div>
    <aside class="intro-note"><span class="note-label">Start with three questions</span><ol><li>What needs to happen next?</li><li>How much cash will I need?</li><li>What could delay my opening?</li></ol><p>Your plan helps you work through each one, at your own pace.</p></aside>
  </section>
  <section aria-labelledby="workspace-title" class="workspace-section">
    <div class="section-title"><div><p class="eyebrow">A place to come back to</p><h2 id="workspace-title">Your saved work</h2></div><p>From this browser only. Use each tool’s backup download to keep a copy.</p></div>
    <noscript><p>Enable JavaScript to see saved progress. The links below still open the planning tools.</p></noscript>
    <div class="plan-grid">
      <article class="plan-card">
        <span class="card-number">01 / Your next steps</span><h3>Startup checklist</h3>
        <p id="saved-checklist">Create a plan with tasks that fit your practice, suggested dates, and clear owners.</p>
        <ol id="saved-next" class="saved-next"></ol>
        <a class="card-action" href="/resources/startup-checklist/" id="checklist-action">Build my checklist <span aria-hidden="true">→</span></a>
      </article>
      <article class="plan-card">
        <span class="card-number">02 / Your financial picture</span><h3>Startup cash forecast</h3>
        <p id="saved-finance">Estimate startup costs, monthly cash, and the funding needed to keep a reserve.</p>
        <div id="saved-cash"></div>
        <a class="card-action" href="/resources/pro-forma/" id="finance-action">Build my financial plan <span aria-hidden="true">→</span></a>
      </article>
      <article class="plan-card research-card">
        <span class="card-number">03 / Your market</span><h3>Research your location</h3>
        <p>Explore your ZIP and specialty to ask better questions about local demand, competition, and your launch.</p>
        <p class="card-note">Use the research alongside your own local knowledge and conversations.</p>
        <a class="card-action" href="/resources/startup-research/">Explore my market <span aria-hidden="true">→</span></a>
      </article>
    </div>
    <p class="storage-note" id="workspace-note" role="status">Clearing browser data removes saved work. This overview reads your existing plans; it does not upload them.</p>
  </section>
  <PracticeElfHandoff />
  <section class="roadmap-section" aria-labelledby="roadmap-title">
    <div class="section-title"><div><p class="eyebrow">The whole journey</p><h2 id="roadmap-title">Seven phases. One practice.</h2></div><a class="text-link" href="/journey/">Explore the launch roadmap →</a></div>
    <div class="roadmap-grid">{phases.map(([name, detail, slug], i) => <a href={`/journey/${slug}/`}><span>0{i + 1}</span><h3>{name}</h3><p>{detail}</p></a>)}</div>
  </section>
  <section class="help-section"><div><p class="eyebrow">Support when you want it</p><h2>Bring your plan. Bring your questions.</h2><p>Talk through your timeline, credentialing, and next decisions with PPS. You choose when to share your information.</p></div><a class="button" href="/schedule-meeting/">Book a free consultation →</a></section>
</div>
<script>import "../scripts/launch-home";</script>
<style>
.launch-home{max-width:1320px;margin:auto;padding:32px 28px 70px;color:#142647}.home-intro{display:grid;grid-template-columns:1.5fr 1fr;gap:64px;align-items:center;background:#142647;border-radius:22px;padding:56px;color:#fff}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:11px;font-weight:700;margin-bottom:14px}.home-intro .eyebrow{color:#bde7d6}h1{color:#fff;font-size:clamp(38px,4vw,60px);font-weight:650;letter-spacing:-.045em;line-height:1.06;max-width:650px}.intro{font-size:18px;line-height:1.7;margin:24px 0;color:#d6e0ed;max-width:640px}.intro-actions{display:flex;flex-wrap:wrap;gap:20px;align-items:center}.button{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:15px 20px;background:#c7efdf;color:#133c34;border-radius:8px;text-decoration:none;font-weight:650;min-height:48px}.light-link{color:#fff;font-size:14px;text-decoration:underline;text-underline-offset:5px}.promise{color:#c8d8e6;font-size:12px;margin-top:23px;line-height:1.7}.intro-note{border:1px solid #63788f;border-radius:16px;padding:30px;background:#ffffff07}.note-label{font-size:12px;color:#c7efdf}.intro-note ol{list-style:decimal;padding-left:24px;display:grid;gap:18px;margin:24px 0;font-size:18px;line-height:1.5}.intro-note p{font-size:14px;color:#ccdae7;line-height:1.7}.workspace-section,.roadmap-section{margin-top:48px}.section-title{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:24px}.section-title h2,.help-section h2{font-size:30px;letter-spacing:-.035em;font-weight:650}.section-title>p{font-size:13px;color:#5a6a80;max-width:310px;line-height:1.6}.plan-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.plan-card{border:1px solid #dce4ee;background:#fff;border-radius:15px;padding:28px;display:flex;flex-direction:column;min-width:0}.card-number{font-size:11px;color:#476282;font-weight:650;letter-spacing:.06em}.plan-card h3{font-size:25px;letter-spacing:-.035em;margin:16px 0}.plan-card>p{color:#52627a;font-size:14px;line-height:1.7}.card-action{display:flex;gap:12px;justify-content:space-between;margin-top:auto;padding-top:25px;font-size:14px;font-weight:650;color:#254ac1;min-height:48px}.research-card{background:#edf6f1}.card-note{margin-top:20px}.storage-note{font-size:12px;line-height:1.6;color:#5a6a80;margin-top:18px}.roadmap-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #dce4ee}.roadmap-grid a{padding:26px 24px 26px 0;border-bottom:1px solid #dce4ee}.roadmap-grid span{font-size:12px;color:#58718f}.roadmap-grid h3{font-size:20px;font-weight:650;margin:10px 0}.roadmap-grid p{font-size:14px;color:#52627a;line-height:1.6}.text-link{font-size:14px;color:#254ac1}.help-section{margin-top:45px;border-radius:18px;padding:35px;background:#edf2fa;display:flex;align-items:center;justify-content:space-between;gap:30px}.help-section p:not(.eyebrow){max-width:620px;font-size:15px;line-height:1.7;margin-top:14px}.help-section .button{background:#3155d9;color:#fff;flex-shrink:0}.launch-home a:focus-visible{outline:3px solid #3155d9;outline-offset:5px}.launch-home a:hover{text-decoration:underline;text-underline-offset:4px}
.saved-next{list-style:decimal;padding-left:20px;font-size:13px;line-height:1.6;margin-top:18px}.saved-next :global(li){margin-bottom:10px}.saved-next :global(a){color:#254ac1}#saved-cash :global(dl){margin-top:18px}#saved-cash :global(dt){font-size:12px;color:#52627a}#saved-cash :global(dd){font-size:26px;font-weight:650;margin:4px 0 12px}#saved-cash :global(p){font-size:12px;line-height:1.6;color:#52627a}
@media(max-width:1000px){.home-intro{padding:36px;gap:30px}.plan-grid{grid-template-columns:1fr 1fr}.research-card{grid-column:1/-1}.roadmap-grid{grid-template-columns:repeat(3,1fr)}.help-section{flex-direction:column;align-items:start}}
@media(max-width:640px){.launch-home{padding:18px 16px 40px}.home-intro{grid-template-columns:1fr;padding:27px 22px;gap:28px}.intro-note{padding:22px}.intro{font-size:16px}.plan-grid{grid-template-columns:1fr}.plan-card{padding:24px}.section-title{align-items:start;flex-direction:column;gap:12px}.roadmap-grid{grid-template-columns:1fr 1fr}.help-section{padding:25px}.section-title h2,.help-section h2{font-size:27px}}
</style>
