---
import type { Phase } from '@data/phases';
import { phases } from '@data/phases';
interface Props {phase:Phase}
const { phase } = Astro.props;
const index = phases.findIndex(p=>p.id===phase.id);
const previous = phases[index-1];
const next = phases[index+1];
---
<section class="learn-hero learn-phase-hero"><div class="learn-wrap learn-hero-grid"><div><a class="learn-link" href="/journey/">All seven launch stages</a><div class="learn-eyebrow" style="margin-top:24px">Stage {phase.id} · {phase.verb}</div><h1 class="learn-title">{phase.title}</h1><p class="learn-intro">{phase.subtitle}</p><div class="learn-actions"><a class="learn-btn" href="/resources/startup-checklist/">Make this part of my checklist</a><a class="learn-btn secondary" href="#stage-plan">Explore this stage</a></div></div><aside class="learn-phase-aside"><div class="learn-eyebrow">The decision in front of you</div><h2>{phase.question}</h2><p>{phase.decision}</p><nav aria-label="Adjacent launch stages">{previous && <a href={`/journey/${previous.slug}/`}>Previous: {previous.title}</a>}{next && <a href={`/journey/${next.slug}/`}>Next: {next.title}</a>}</nav></aside></div></section>
