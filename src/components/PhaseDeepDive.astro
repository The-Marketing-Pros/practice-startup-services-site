---
import type { PhaseId } from '@data/phases';
import { getDeepDive } from '@data/phase-deep-dives';
interface Props {phaseId:PhaseId}
const { phaseId } = Astro.props;
const detail = getDeepDive(phaseId);
---
{detail && <section class="learn-section"><div class="learn-wrap learn-split"><div><div class="learn-eyebrow">A closer look</div><h2>Make the decisions with context.</h2><p class="learn-intro">{detail.intro}</p><div class="learn-actions"><a class="learn-link" href="/resources/articles/">More practical articles</a><a class="learn-link" href="/resources/videos/">Future video walkthroughs</a></div>{phaseId==='04' && <p class="learn-note"><a class="learn-link" href="https://www.cms.gov/medicare/enrollment-renewal/providers-suppliers">CMS enrollment guidance</a></p>}</div><div class="learn-prose">{detail.sections.map(section=><section><h3 style="font-size:23px;margin-bottom:14px">{section.heading}</h3>{section.body.split(/\n\n+/).map(text=><p>{text}</p>)}</section>)}{detail.faq && <div class="learn-panel"><h3 style="font-size:24px;margin-bottom:20px">Questions for this stage</h3>{detail.faq.map(item=><details class="learn-faq"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>}</div></div></section>}
<style>.learn-faq{border-top:1px solid #dce4ef;padding:16px 0}.learn-faq summary{cursor:pointer;font-size:16px;font-weight:650;line-height:1.5;min-height:44px;padding:8px 0}.learn-faq p{font-size:15px;margin:12px 0 0}</style>
