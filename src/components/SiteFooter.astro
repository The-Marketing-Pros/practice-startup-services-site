---
import { NAV, SITE } from '@data/site';
const year = new Date().getFullYear();
const groups = ['Free Resources', 'Launch roadmap', 'Services'].map(label => NAV.find(item => item.label === label)!);
const directories = ['By Specialty', 'By State', 'Who We Help'].map(label => NAV.find(item => item.label === label)!);
---
<footer class="site-footer">
  <div class="footer-wrap">
    <div class="footer-intro">
      <div><h2>{SITE.tagline}</h2><p>{SITE.promise}</p></div>
      <a href={SITE.scheduleUrl} class="footer-cta">{SITE.primaryCta}</a>
    </div>
    <nav class="footer-columns" aria-label="Footer">
      {groups.map(group => <section class="footer-group"><h3><a href={group.href}>{group.label}</a></h3><ul>{group.children.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul></section>)}
      <section class="footer-group"><h3>Explore PPS</h3><ul>
        <li><a href="/about/">About PPS</a></li>
        <li><a href="/who-we-help/">Who we help</a></li>
        <li><a href="/specialty/">Guides by specialty</a></li>
        <li><a href="/states/">Guides by state</a></li>
        <li><a href="https://physicianpracticespecialists.com/">Visit the full PPS website</a></li>
        <li><a href="/resources/medicare-tools/">Medicare reference guide</a></li>
      </ul></section>
    </nav>
    <div class="footer-directories" aria-label="All practice guides">
      {directories.map(group => <details><summary>{group.label}</summary><ul>{group.children.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul></details>)}
    </div>
    <div class="footer-bottom"><p>© {year} Practice Startup Services. A PPS resource for independent practices.</p><nav aria-label="Legal"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav></div>
  </div>
</footer>
<style>
.site-footer{background:#10213f;color:#cbd7e8;margin-top:64px}
.footer-wrap{width:min(1200px,calc(100% - 64px));margin-inline:auto;padding:48px 0 24px}
.footer-intro{display:flex;align-items:center;justify-content:space-between;gap:40px;padding-bottom:32px;border-bottom:1px solid #ffffff25}
.footer-intro>div{max-width:690px;min-width:0}
.footer-intro h2{color:#fff;font-size:clamp(26px,3vw,34px);line-height:1.2;letter-spacing:-.035em;margin-bottom:12px}
.footer-intro p{max-width:640px;font-size:15px;line-height:1.75}
.footer-cta{display:inline-flex;justify-content:center;align-items:center;min-height:48px;padding:12px 20px;background:#b8eed6;border-radius:8px;color:#10213f;font-size:14px;font-weight:650;flex-shrink:0;text-align:center}
.footer-columns{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px;padding:32px 0}
.footer-group{min-width:0}.footer-group h3{display:flex;align-items:center;min-height:40px;font-family:inherit;color:#fff;font-size:16px;line-height:1.4;letter-spacing:0;margin-bottom:12px;font-weight:650}
.footer-group h3 a{color:inherit;display:inline-flex;align-items:center;min-height:40px}
.footer-group ul,.footer-directories ul{list-style:none;padding:0;margin:0}
.footer-group li a,.footer-directories li a{display:flex;align-items:center;min-height:40px;padding:7px 0;font-size:14px;line-height:1.55;color:#cbd7e8;text-decoration:none;overflow-wrap:break-word}
.footer-group a:hover,.footer-directories a:hover,.footer-bottom a:hover{color:white;text-decoration:underline;text-underline-offset:4px}
.footer-directories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding:20px 0;border-top:1px solid #ffffff25;border-bottom:1px solid #ffffff25;align-items:start}
.footer-directories summary{cursor:pointer;color:#dbe6f6;font-size:14px;font-weight:600;line-height:1.5;padding:12px 0;min-height:44px}
.footer-directories ul{padding:8px 0 12px}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;gap:24px;padding-top:20px;font-size:12px;line-height:1.6;color:#b7c6dc}
.footer-bottom nav{display:flex;gap:24px;flex-shrink:0}.footer-bottom a{display:inline-flex;align-items:center;min-height:44px}
.site-footer :focus-visible{outline:3px solid #b8eed6;outline-offset:4px}
@media(max-width:1000px){.footer-columns{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:48px}.footer-intro{align-items:start;flex-direction:column;gap:20px}}
@media(max-width:600px){.site-footer{margin-top:40px}.footer-wrap{width:calc(100% - 36px);padding-top:32px}.footer-columns{column-gap:24px;row-gap:28px}.footer-group li a{min-height:44px}.footer-directories{grid-template-columns:1fr;gap:0}.footer-directories details+details{border-top:1px solid #ffffff18}.footer-bottom{align-items:start;flex-direction:column;gap:4px}.footer-intro h2{font-size:28px}}
@media(max-width:380px){.footer-columns{grid-template-columns:1fr}.footer-group h3{margin-bottom:4px}}
@media print{.site-footer{display:none}}
</style>
